<style>
:root{
  --bg:#F5F7F6; --surface:#FFFFFF; --ink:#172033; --muted:#566074; --line:#D8DDE3;
  --azure:#1F5FC9; --azure-soft:#E3ECFA; --gcp:#5B6475; --ok:#23845A; --ok-soft:#DFF1E8;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0F1724; --surface:#162133; --ink:#E7ECF3; --muted:#9AA6B8; --line:#2A3850;
    --azure:#7AA8F5; --azure-soft:#1C2E4E; --gcp:#9AA6B8; --ok:#5CC796; --ok-soft:#173A2C;
  }
}
:root[data-theme="dark"]{
  --bg:#0F1724; --surface:#162133; --ink:#E7ECF3; --muted:#9AA6B8; --line:#2A3850;
  --azure:#7AA8F5; --azure-soft:#1C2E4E; --gcp:#9AA6B8; --ok:#5CC796; --ok-soft:#173A2C;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 var(--body);-webkit-font-smoothing:antialiased}
img{max-width:100%}
a{color:var(--azure);text-underline-offset:3px}
a:focus-visible,button:focus-visible{outline:3px solid var(--azure);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}

/* Nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
.brand{font:700 19px/1 var(--display);color:var(--ink);text-decoration:none}
.links{display:flex;gap:22px;list-style:none;margin:0;padding:0}
.links a{color:var(--muted);text-decoration:none;font-weight:500;font-size:15px}
.links a:hover{color:var(--ink)}
@media (max-width:640px){.links{display:none}}

/* Hero */
header.hero{padding:72px 0 64px}
.hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center}
@media (max-width:900px){.hero-grid{grid-template-columns:1fr;gap:40px}}
h1{font:800 clamp(44px,7vw,76px)/0.98 var(--display);letter-spacing:-0.025em;margin:0 0 18px}
.role{font:500 clamp(19px,2.2vw,23px)/1.35 var(--display);margin:0 0 20px;color:var(--ink)}
.intro{color:var(--muted);max-width:52ch;margin:0 0 30px}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.btn{display:inline-block;padding:12px 20px;border-radius:8px;font-weight:600;font-size:15px;text-decoration:none;border:1.5px solid var(--ink);color:var(--ink)}
.btn.primary{background:var(--ink);color:var(--bg)}
.btn:hover{transform:translateY(-1px)}

/* Migration diagram */
.migration{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:26px}
.migration h2{font:700 17px/1.3 var(--display);margin:0 0 4px}
.migration p.sub{margin:0 0 20px;color:var(--muted);font-size:14px}
.map{display:grid;grid-template-columns:1fr 54px 1fr;row-gap:10px;align-items:center}
.col-head{font-size:13px;font-weight:600;color:var(--muted);padding-bottom:4px}
.svc{padding:10px 12px;border-radius:8px;font-weight:500;font-size:15px}
.svc.from{border:1.5px dashed var(--line);color:var(--gcp)}
.svc.to{background:var(--azure-soft);color:var(--azure);border:1.5px solid transparent}
.arrow{position:relative;height:2px;margin:0 8px;background:var(--line);overflow:hidden}
.arrow::after{content:"";position:absolute;inset:0;background:var(--azure);transform:scaleX(0);transform-origin:left;animation:draw .6s ease-out forwards}
.r1 .arrow::after{animation-delay:.3s}
.r2 .arrow::after{animation-delay:.7s}.r3 .arrow::after{animation-delay:1.1s}
.row{display:contents}
.r1 .to,.r2 .to,.r3 .to{opacity:0;animation:land .4s ease-out forwards}
.r1 .to{animation-delay:.8s}.r2 .to{animation-delay:1.2s}.r3 .to{animation-delay:1.6s}
@keyframes draw{to{transform:scaleX(1)}}
@keyframes land{to{opacity:1}}
.stages{display:flex;align-items:center;gap:8px;margin-top:22px;padding-top:18px;border-top:1px solid var(--line);flex-wrap:wrap;font-size:14px}
.stages .label{color:var(--muted);margin-right:4px}
.stage{padding:5px 11px;border-radius:999px;background:var(--ok-soft);color:var(--ok);font-weight:600}
.stages .sep{width:16px;height:2px;background:var(--ok);opacity:.5}
@media (prefers-reduced-motion:reduce){
  .arrow::after{animation:none;transform:scaleX(1)}
  .r1 .to,.r2 .to,.r3 .to{animation:none;opacity:1}
  html{scroll-behavior:auto}
  .btn:hover{transform:none}
}

/* Sections */
section{padding:72px 0;border-top:1px solid var(--line)}
h2.section{font:700 clamp(30px,4vw,40px)/1.1 var(--display);letter-spacing:-0.015em;margin:0 0 12px}
.lede{color:var(--muted);max-width:62ch;margin:0 0 40px}

/* Case studies */
.cases{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
@media (max-width:760px){.cases{grid-template-columns:1fr}}
.case{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:26px}
.case.wide{grid-column:1/-1}
.case h3{font:700 21px/1.25 var(--display);margin:0 0 10px}
.case p{margin:0 0 16px;color:var(--muted)}
.tools{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0}
.tools li{font-size:13px;font-weight:500;padding:3px 10px;border-radius:6px;border:1px solid var(--line);color:var(--ink)}
.note{font-size:14px;color:var(--muted);margin-top:24px}

/* Experience timeline */
.timeline{position:relative;margin:0;padding:0 0 0 28px;list-style:none;border-left:2px solid var(--line)}
.job{position:relative;padding-bottom:44px}
.job:last-child{padding-bottom:0}
.job::before{content:"";position:absolute;left:-36px;top:7px;width:14px;height:14px;border-radius:50%;background:var(--bg);border:3px solid var(--azure)}
.job.past::before{border-color:var(--muted)}
.job-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;margin-bottom:12px}
.job h3{font:700 22px/1.25 var(--display);margin:0}
.job .org{color:var(--muted);font-weight:500}
.job .when{color:var(--muted);font-size:15px;white-space:nowrap}
.job ul{margin:0;padding-left:20px;max-width:75ch}
.job li{margin-bottom:8px}
.job li::marker{color:var(--azure)}

/* Skills */
.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:28px 32px}
@media (max-width:860px){.skills{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.skills{grid-template-columns:1fr}}
.skills h3{font:700 17px/1.3 var(--display);margin:0 0 6px}
.skills p{margin:0;color:var(--muted);font-size:15px}

/* Education + contact */
.two{display:grid;grid-template-columns:1fr 1fr;gap:40px}
@media (max-width:760px){.two{grid-template-columns:1fr}}
.two h3{font:700 21px/1.3 var(--display);margin:0 0 6px}
.two p{margin:0;color:var(--muted)}
.contact-list{list-style:none;padding:0;margin:0;display:grid;gap:10px}
.contact-list span{display:inline-block;min-width:84px;color:var(--muted);font-size:15px}
footer{padding:32px 0 40px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}
</style>
</head>
